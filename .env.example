# ZOVAX environment template.
#
# Copy to .env and fill in. Real values are never committed - .gitignore
# ignores .env* at every depth, and this file is the only exception.
# Verified with `git check-ignore`: .env, apps/api/.env and
# apps/admin/.env.local are all ignored by rule .gitignore:8.
#
# The API validates these at BOOT and refuses to start if a required one is
# missing or malformed. A service that starts without its database and fails
# on the first request is harder to diagnose than one that never starts.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string. A free M0 cluster is enough to build and
# test against. Include the database name in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zovax

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# From the Cloudinary dashboard. The API secret signs uploads, so it must
# never reach the browser: the admin portal uploads through the API rather
# than directly to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secrets. Generate with: openssl rand -base64 48
# Access and refresh use DIFFERENT secrets, so a leaked access token cannot be
# used to mint refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# The first owner account, created on first boot only if no admin exists.
# It is flagged mustChangePassword; change it immediately after signing in.
ADMIN_SEED_EMAIL=info@zovax.lk
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated origins allowed to call the API. No wildcard in production:
# the admin portal sends its refresh token as a credentialed cookie, and
# browsers reject a wildcard origin with credentials anyway.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# ---------------------------------------------------------------------------
# Storefront and admin (Vite - these reach the browser)
# ---------------------------------------------------------------------------
# Only VITE_-prefixed variables are exposed to client code. Never put a secret
# behind this prefix: it is compiled into the bundle and readable by anyone.
VITE_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Company profile seed (docs/specs/admin-and-api/design.md §7.4)
# ---------------------------------------------------------------------------
# Read ONCE, by the migration script, to seed the `settings` collection's
# company profile on first run. Not secrets - an address, a hotline and an
# email deliberately shown on the storefront - but they are still left blank
# here rather than pre-filled, because CompanyProfile.ts is the one tracked
# file allowed to hold the real values (I4); duplicating them into a second
# tracked file, even a non-secret one, is the exact drift I4 exists to
# prevent. Fill these from CompanyProfile.ts's current values before running
# the migration, then leave them - the admin UI is the only path that changes
# them from here on, and check:contact never needs to know apps/api exists.
COMPANY_ADDRESS=
COMPANY_HOTLINE_DISPLAY=
COMPANY_HOTLINE_DIAL=
COMPANY_EMAIL=
